# copy to .env.local for development, and add the same keys in Vercel → Settings → Environment Variables
# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# server only, never prefix with NEXT_PUBLIC. bypasses RLS
SUPABASE_SECRET_KEY=
# any long random string. Vercel sends it to the daily cron
CRON_SECRET=
# used to build invite and recovery links, e.g. https://jpcs-tsu.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
